# FitCheck delivery. Do not commit real secrets.
# If none of these are set, submissions still succeed in the UI and are logged server-side.

# Resend (preferred)
RESEND_API_KEY=
RESEND_FROM=Fit met Levi <noreply@your-verified-domain>
FITCHECK_TO_EMAIL=

# Firebase Admin (optional fallback, writes to collection `fitchecks`)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
